DATABASE_URL="postgresql://labtrack:change-me@localhost:5432/labtrack?schema=public"
POSTGRES_PASSWORD="change-me"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
APP_TIME_ZONE="Asia/Shanghai"
APP_TIME_ZONE_OFFSET="+08:00"
UPLOAD_DIR="./storage"
MAX_UPLOAD_MB="5"
# Optional S3-compatible storage; set all three plus bucket to enable.
# S3_ENDPOINT="https://s3.example.com"
# S3_REGION="auto"
# S3_BUCKET="labtrack"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Bootstrap only: supply credentials to db:seed; never use these in production after setup.
# SEED_ADMIN_USERNAME="admin"
# SEED_ADMIN_PASSWORD=""
# SEED_DEMO="true"
# SEED_DEMO_PASSWORD=""
